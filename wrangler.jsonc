// Cloudflare-Konfiguration für Streamfinder
// Ein Worker liefert die Seite aus (Dateien im Repository) und ist gleichzeitig der Proxy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streaming",
  "main": "worker/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Die Seite: alle Dateien aus dem Repository. Alles andere (/3/, /sa/, /api/, /omdb) geht an den Worker.
  "assets": { "directory": "." },

  // Speicher für Sync und Push. Cloudflare legt ihn beim ersten Deploy selbst an.
  "kv_namespaces": [ { "binding": "SF_KV" } ],

  // Täglicher Check der Listen um 07:00 UTC (08:00 Uhr Winterzeit)
  "triggers": { "crons": ["0 7 * * *"] },

  // Variablen aus dem Dashboard bei jedem Deploy behalten
  "keep_vars": true
}
